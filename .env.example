# ============================================================
# Sport Center — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to version control.
#
# ISOLATION RULES:
#   1. Development MUST use SUPABASE_DATABASE_URL_DEV.
#      Server REFUSES to start if not set (unless ALLOW_DEV_ON_PROD_DB=true).
#   2. Development MUST use SUPABASE_SERVICE_ROLE_KEY_DEV for Storage.
#      Server REFUSES to start if not set (unless ALLOW_DEV_ON_PROD_STORAGE=true).
#   3. Development SHOULD use SUPABASE_URL_DEV + SUPABASE_ANON_KEY_DEV for Realtime.
#      If not set, realtime is a no-op (not a fatal error).

# ── Database (Production) ────────────────────────────────────
# Transaction Pooler URL from Supabase Dashboard → Settings → Database
# Port 6543 (PgBouncer), not 5432 (direct).
SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# ── Database (Development — REQUIRED for dev) ────────────────
# MUST point to a separate Supabase project or Replit Postgres.
# If empty, dev server will REFUSE to start (see ALLOW_DEV_ON_PROD_DB).
SUPABASE_DATABASE_URL_DEV=postgresql://postgres:[ref-dev]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# ── Database Emergency Override ───────────────────────────────
# Set to "true" ONLY when intentionally allowing dev to use prod DB.
# NEVER leave this true in normal development — any dev write hits prod.
ALLOW_DEV_ON_PROD_DB=false

# ── Database Fallback ─────────────────────────────────────────
# Only used if neither Supabase URL is available.
DATABASE_URL=postgresql://postgres:password@helium:5432/heliumdb

# ── Supabase Project (Production) ────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=eyJ...              # Public anon key
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # Server-only service role key

# ── Supabase Project (Development — REQUIRED for dev Storage) ─
# MUST be a separate Supabase project from production.
# SUPABASE_SERVICE_ROLE_KEY_DEV is REQUIRED for dev uploads.
# Server REFUSES to start in dev if this is missing (unless ALLOW_DEV_ON_PROD_STORAGE=true).
#
# SUPABASE_URL_DEV + SUPABASE_ANON_KEY_DEV are optional (Realtime).
# If not set, realtime is a no-op in dev (not fatal).
SUPABASE_URL_DEV=https://[ref-dev].supabase.co
SUPABASE_ANON_KEY_DEV=eyJ...          # Dev anon key
SUPABASE_SERVICE_ROLE_KEY_DEV=eyJ...  # Dev service role key (REQUIRED for dev uploads)

# ── Storage Emergency Override ────────────────────────────────
# Set to "true" ONLY when intentionally allowing dev uploads to prod storage.
# NEVER leave this true in normal development — any file upload hits prod.
ALLOW_DEV_ON_PROD_STORAGE=false

# ── BizPortal Sync ───────────────────────────────────────────
# Required for BizPortal to pull data via GET /api/sync/*
# Generate: openssl rand -hex 32
BIZPORTAL_SYNC_API_KEY=your-strong-random-api-key-here

# ── Auth ─────────────────────────────────────────────────────
SESSION_SECRET=your-strong-random-session-secret

# ── WhatsApp (Fonnte) ────────────────────────────────────────
FONNTE_TOKEN=your-fonnte-token
ADMIN_WA_PHONES=+628123456789         # Comma-separated admin WA numbers

# ── Google OAuth + Sheets ────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Deprecated (set in secrets, not read by code) ────────────
# See docs/supabase-env-audit.md for full explanation.
# SUPABASE_PG_URL         — redundant alias of SUPABASE_DATABASE_URL, can be removed
# SUPABASE_STORAGE_BUCKET — buckets addressed explicitly in code, this is ignored
