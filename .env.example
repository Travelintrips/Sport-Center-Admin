# ============================================================
# Sport Center — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to version control.

# ── Database ─────────────────────────────────────────────────
# Production Supabase PostgreSQL (Transaction Pooler port 6543)
SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# Development Supabase PostgreSQL (separate project or Replit Postgres)
# If not set, dev will fall back to DATABASE_URL.
# WARNING: if neither is set, dev falls back to SUPABASE_DATABASE_URL (prod) — avoid this!
SUPABASE_DATABASE_URL_DEV=postgresql://postgres.[ref-dev]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# Replit managed Postgres (used as last-resort fallback)
DATABASE_URL=postgresql://postgres:password@helium:5432/heliumdb

# ── Supabase Project ─────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=eyJ...         # Public anon key
SUPABASE_SERVICE_ROLE_KEY=eyJ... # Secret service role key (server-only)

# ── BizPortal Sync ───────────────────────────────────────────
# Required for BizPortal to pull data via GET /api/sync/*
# Generate a strong random string, e.g.: openssl rand -hex 32
BIZPORTAL_SYNC_API_KEY=your-strong-random-api-key-here

# ── Auth ─────────────────────────────────────────────────────
SESSION_SECRET=your-strong-random-session-secret

# ── WhatsApp (Fonnte) ────────────────────────────────────────
FONNTE_TOKEN=your-fonnte-token
ADMIN_WA_PHONES=+628123456789  # Comma-separated admin WA numbers

# ── Google OAuth + Sheets ────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Deprecated (kept for backward compat, not used in code) ──
# SUPABASE_URL_DEV       — set but unused; see docs/supabase-env-audit.md
# SUPABASE_PG_URL        — redundant alias of SUPABASE_DATABASE_URL
# SUPABASE_STORAGE_BUCKET — buckets are addressed explicitly in code
